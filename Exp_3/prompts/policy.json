  "rule": "is 0.75 or more"
 },
 {
  "id": "RAISE_HIGH_INTEREST_LOANS",
  "kind": "raises_risk",
  "tool": "get_previous_applications",
  "field": "prev_high_interest_share",
  "rule": "is 0.75 or more"
 },
 {
  "id": "RAISE_CARD_CASH_WITHDRAWALS",
  "kind": "raises_risk",
  "tool": "get_credit_card_history",
  "field": "card_atm_withdrawals_per_month",
  "rule": "is 1.0 or more"
 },
 {
