[
 {
  "id": "HIGH_ANNUITY_TO_INCOME",
  "kind": "red_flag",
  "tool": "get_applicant_profile",
  "field": "annuity_to_income",
  "rule": "is {HIGH_ANNUITY_TO_INCOME} or more (the top 5% of past applicants)",
  "other_fields": [
   "annuity_to_income_percentile"
  ]
 },
 {
  "id": "LOW_EXT_SCORE",
  "kind": "red_flag",
  "tool": "get_applicant_profile",
  "field": "external_score_mean",
  "rule": "is {LOW_EXT_SCORE} or less (the bottom 10% of past applicants)",
  "other_fields": [
   "external_score_percentile"
  ]
 },
 {
  "id": "RECENT_ID_CHANGE",
  "kind": "red_flag",
  "tool": "get_applicant_profile",
  "field": "years_since_id_change",
  "rule": "is 1.0 or less"
 },
 {
  "id": "RECENT_PHONE_CHANGE",
  "kind": "red_flag",
  "tool": "get_applicant_profile",
  "field": "days_since_phone_change",
  "rule": "is 30 or less"
 },
 {
  "id": "SHORT_EMPLOYMENT",
  "kind": "red_flag",
  "tool": "get_applicant_profile",
  "field": "years_employed",
  "rule": "is below 1.0"
 },
 {
  "id": "MANY_ENQUIRIES",
