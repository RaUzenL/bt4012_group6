 },
 {
  "id": "LOWER_LONG_EMPLOYMENT",
  "kind": "lowers_risk",
  "tool": "get_applicant_profile",
  "field": "years_employed",
  "rule": "is 10.0 or more"
 },
 {
  "id": "LOWER_OLD_BUREAU_LOANS",
  "kind": "lowers_risk",
