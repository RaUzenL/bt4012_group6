   "source": [
    "# Reuse predictions already generated in Section 8; no additional LSTM training.\n",
    "PRIMARY_PAIRS = [('M_app_LSTM', 'M_app'), ('M2', 'M0')]\n",
    "N_BOOT = 2000\n",
    "rng = np.random.default_rng(SEED + 620)\n",
    "y_val = y[val_idx]\n",
    "\n",
    "def _safe_pair_metric(y_true, p, metric):\n",
    "    if metric == 'roc_auc':\n",
    "        return roc_auc_score(y_true, p) if len(np.unique(y_true)) == 2 else np.nan\n",
    "    return average_precision_score(y_true, p) if np.any(y_true == 1) else np.nan\n",
    "\n",
    "contrast_rows = []\n",
    "for newer, baseline in PRIMARY_PAIRS:\n",
    "    p_new = np.asarray(val_predictions[newer], dtype=float)\n",
    "    p_base = np.asarray(val_predictions[baseline], dtype=float)\n",
    "    for metric in ('roc_auc', 'pr_auc'):\n",
    "        delta = _safe_pair_metric(y_val, p_new, metric) - _safe_pair_metric(y_val, p_base, metric)\n",
    "        boot = []\n",
    "        for _ in range(N_BOOT):\n",
    "            sampled = rng.integers(0, len(y_val), size=len(y_val))\n",
    "            ys = y_val[sampled]\n",
    "            if len(np.unique(ys)) < 2:\n",
    "                continue\n",
    "            boot.append(_safe_pair_metric(ys, p_new[sampled], metric) -\n",
    "                        _safe_pair_metric(ys, p_base[sampled], metric))\n",
    "        lo, hi = np.percentile(boot, [2.5, 97.5])\n",
    "        contrast_rows.append({'contrast': f'{newer} - {baseline}', 'metric': metric,\n",
    "                              'delta': delta, 'ci_low': lo, 'ci_high': hi,\n",
    "                              'ci_excludes_zero': bool(lo > 0 or hi < 0)})\n",
    "\n",
    "control_comparison = pd.DataFrame(contrast_rows)\n",
    "display(fusion_results[fusion_results.model.isin(['M_app','M_app_LSTM','M0','M2'])]\n",
    "        .sort_values('model').reset_index(drop=True))\n",
    "display(control_comparison)\n",
    "control_comparison.to_csv(OUTPUT_DIR / 'application_lstm_control_contrasts_v6.csv', index=False)\n",
    "\n",
    "# Descriptive difference-in-uplifts; do not label it a causal estimate.\n",
    "for metric in ('roc_auc', 'pr_auc'):\n",
    "    part = control_comparison.set_index(['contrast','metric'])\n",
    "    d_app = part.loc[('M_app_LSTM - M_app', metric), 'delta']\n",
    "    d_hist = part.loc[('M2 - M0', metric), 'delta']\n",
    "    print(f'{metric}: app + LSTM uplift = {d_app:+.5f}; '\n",
    "          f'aggregates + LSTM uplift = {d_hist:+.5f}; '\n",
    "          f'descriptive gap = {d_app-d_hist:+.5f}')\n"
   ]
