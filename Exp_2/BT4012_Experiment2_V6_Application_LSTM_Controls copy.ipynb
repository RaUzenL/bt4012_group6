    "seq_train = seq[train_idx][observed[train_idx]]\n",
    "med = np.nanmedian(seq_train, axis=0); med = np.where(np.isfinite(med), med, 0).astype('float32')\n",
    "filled = np.where(np.isfinite(seq_train), seq_train, med)\n",
    "scaler = StandardScaler().fit(filled)\n",
    "Xseq = np.where(np.isfinite(seq), seq, med.reshape(1, 1, -1))\n",
    "Xseq = scaler.transform(Xseq.reshape(-1, N_CH)).reshape(seq.shape).astype('float32')\n",
    "Xseq[~observed] = 0\n",
    "Xseq = np.concatenate([Xseq, observed[..., None].astype('float32')], axis=-1)\n",
    "\n",
    "# Aggregate same-window features for independent representation comparison.\n",
    "agg = i_seq.groupby('SK_ID_CURR').agg(\n",
    "    DPD_MEAN=('DPD','mean'), DPD_MAX=('DPD','max'), LATE_RATE=('LATE','mean'),\n",
    "    PAY_RATIO=('PAY_RATIO','mean'), UNDER_RATIO=('UNDER_RATIO','mean'),\n",
    "    AMOUNT_LOG=('AMOUNT_LOG','mean'), N_INST=('SK_ID_PREV','size'),\n",
    "    N_LOANS=('SK_ID_PREV','nunique')).reindex(ids)\n",
    "agg['OBS_MONTHS'] = observed.sum(axis=1)\n",
    "agg['HAS_HISTORY'] = observed.any(axis=1).astype(int)\n",
    "imp = SimpleImputer(strategy='median', keep_empty_features=True); scale = StandardScaler()\n",
    "raw = agg.to_numpy(dtype='float32')\n",
    "imp.fit(raw[train_idx]); scale.fit(imp.transform(raw[train_idx]))\n",
    "Xagg = scale.transform(imp.transform(raw)).astype('float32')\n",
    "assert np.isfinite(Xseq).all() and np.isfinite(Xagg).all()\n",
    "print(f'Sequence tensor: {Xseq.shape} (last channel = observed mask)')"
