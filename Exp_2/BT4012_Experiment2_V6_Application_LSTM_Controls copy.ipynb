    "## 1 · Shared clean data and canonical splits"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "6aabb10b",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "6aabb10b",
    "outputId": "647728c1-ebd2-4c75-c2c4-151b0fc9b8d5"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Split counts: {'train': 69999, 'val': 15001, 'test': 15000}\n"
     ]
    }
   ],
   "source": [
    "CLEAN=DATA_DIR\n",
    "required=['application.parquet','bureau.parquet','bureau_balance.parquet',\n",
    "          'previous_application.parquet','installments.parquet',\n",
    "          'credit_card.parquet','pos_cash.parquet','splits.csv']\n",
    "missing=[x for x in required if not (CLEAN/x).exists()]\n",
    "assert not missing, f'Missing in {CLEAN}: {missing}'\n",
    "splits=pd.read_csv(CLEAN/'splits.csv')\n",
    "assert {'SK_ID_CURR','TARGET','split'}.issubset(splits.columns)\n",
    "splits['split']=splits['split'].str.lower().replace({'validation':'val','valid':'val'})\n",
    "assert splits.SK_ID_CURR.is_unique\n",
    "assert set(splits['split'])=={'train','val','test'}\n",
    "app=pd.read_parquet(CLEAN/'application.parquet').drop(columns=['TARGET'],errors='ignore')\n",
    "app=app.merge(splits[['SK_ID_CURR','TARGET','split']],on='SK_ID_CURR',how='inner',validate='one_to_one')\n",
    "assert len(app)==len(splits)\n",
    "ids=app.SK_ID_CURR.to_numpy(); y=app.TARGET.to_numpy(dtype='int64')\n",
    "train_idx=np.flatnonzero(app['split'].eq('train'));val_idx=np.flatnonzero(app['split'].eq('val'));test_idx=np.flatnonzero(app['split'].eq('test'))\n",
    "print('Split counts:',app['split'].value_counts().to_dict())"
   ]
  },
