   "source": [
    "## 5 · Neural models and train function\n",
    "\n",
    "Attention pools only observed months; customers with no observed months receive a zero pooled vector. The sequence still includes chronological gaps, which can be informative. Validation labels are used **only** for early stopping and model comparison, never to train LSTM weights."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "6a0fc028",
   "metadata": {
    "id": "6a0fc028"
   },
   "outputs": [],
   "source": [
    "class TemporalNet(nn.Module):\n",
    "    def __init__(self, input_dim, hidden=64, attention=True, dropout=.25):\n",
    "        super().__init__()\n",
    "        self.rnn = nn.LSTM(input_dim, hidden, batch_first=True, dropout=0.1, num_layers=2)\n",
    "        self.attention = attention\n",
    "        self.att = nn.Linear(hidden, 1) if attention else None\n",
    "        self.head = nn.Sequential(nn.LayerNorm(hidden), nn.Dropout(dropout), nn.Linear(hidden, 1))\n",
    "\n",
    "    def _pool(self, x):\n",
    "        h, _ = self.rnn(x)\n",
    "        mask = x[:, :, -1] > 0.5\n",
    "        if self.attention:\n",
    "            a = self.att(h).squeeze(-1).masked_fill(~mask, -1e4)\n",
    "            w = torch.softmax(a, dim=1) * mask.float()\n",
    "            w = w / w.sum(dim=1, keepdim=True).clamp_min(1e-8)\n",
    "            pooled = (h * w.unsqueeze(-1)).sum(dim=1)\n",
    "        else:\n",
    "            pooled = h[:, -1, :]\n",
    "        return pooled\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.head(self._pool(x)).squeeze(-1)\n",
    "\n",
    "    def forward_hidden(self, x):\n",
    "        return self._pool(x)\n",
    "\n",
    "def train_temporal(fit_indices, stop_indices, x=Xseq, seed=42, attention=True, verbose=False):\n",
    "    torch.manual_seed(seed)\n",
    "    model = TemporalNet(x.shape[-1], attention=attention).to(DEVICE)\n",
    "    tr = TensorDataset(torch.from_numpy(x[fit_indices]), torch.from_numpy(y[fit_indices].astype('float32')))\n",
    "    loader = DataLoader(tr, batch_size=BATCH_SIZE, shuffle=True)\n",
    "    opt = torch.optim.AdamW(model.parameters(), lr=5e-4, weight_decay=3e-3)\n",
    "    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=1e-5)\n",
    "    default_rate = float(y[fit_indices].mean())\n",
    "    pw = torch.tensor([float((1 - default_rate) / default_rate)], dtype=torch.float32, device=DEVICE)\n",
    "    loss_fn = nn.BCEWithLogitsLoss(pos_weight=pw)\n",
    "    best = -1.; best_state = None; wait = 0\n",
    "    for epoch in range(EPOCHS):\n",
    "        model.train()\n",
    "        for xx, yy in loader:\n",
    "            xx, yy = xx.to(DEVICE), yy.to(DEVICE)\n",
    "            opt.zero_grad(); loss = loss_fn(model(xx), yy); loss.backward()\n",
    "            nn.utils.clip_grad_norm_(model.parameters(), 1.0); opt.step()\n",
    "        scheduler.step()\n",
    "        p = predict_temporal(model, stop_indices, x)\n",
    "        score = roc_auc_score(y[stop_indices], p)\n",
    "        if verbose: print(f'epoch {epoch+1:02d}: stop AUC {score:.5f}')\n",
    "        if score > best + 1e-4: best = score; best_state = copy.deepcopy(model.state_dict()); wait = 0\n",
    "        else:\n",
    "            wait += 1\n",
    "            if wait >= PATIENCE: break\n",
    "    model.load_state_dict(best_state)\n",
    "    return model\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict_temporal(model, indices, x=Xseq):\n",
    "    model.eval()\n",
    "    ds = TensorDataset(torch.from_numpy(x[indices]))\n",
    "    loader = DataLoader(ds, batch_size=BATCH_SIZE * 2)\n",
    "    out = []\n",
    "    for (xx,) in loader:\n",
    "        out.append(torch.sigmoid(model(xx.to(DEVICE))).cpu().numpy())\n",
    "    return np.concatenate(out)\n",
    "\n",
    "@torch.no_grad()\n",
    "def predict_hidden(model, indices, x=Xseq):\n",
    "    model.eval()\n",
    "    ds = TensorDataset(torch.from_numpy(x[indices]))\n",
    "    loader = DataLoader(ds, batch_size=BATCH_SIZE * 2)\n",
    "    out = []\n",
    "    for (xx,) in loader:\n",
    "        out.append(model.forward_hidden(xx.to(DEVICE)).cpu().numpy())\n",
    "    return np.concatenate(out)"
   ]
  },
