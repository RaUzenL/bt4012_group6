    "from sklearn.linear_model import LogisticRegression\n",
    "from scipy.special import logit, expit\n",
    "\n",
    "p_gbdt=np.asarray(val_predictions['M1'],dtype=float)\n",
    "p_lstm=np.asarray(lstm_score[val_idx],dtype=float)\n",
    "y_val=y[val_idx]\n",
    "cal_pos,eval_pos=train_test_split(np.arange(len(val_idx)),test_size=0.5,\n",
    "                                   stratify=y_val,random_state=SEED+202)\n",
    "\n",
    "def cliplogit(p):return logit(np.clip(p,1e-5,1-1e-5))\n",
    "\n",
    "# Static convex blend: choose weight using calibration-only AUC, no evaluation peeking.\n",
    "blend_grid=np.linspace(0,0.5,21)\n",
    "cal_auc=[safe_auc(y_val[cal_pos],(1-w)*p_gbdt[cal_pos]+w*p_lstm[cal_pos]) for w in blend_grid]\n",
    "best_weight=float(blend_grid[int(np.nanargmax(cal_auc))])\n",
    "p_fixed=(1-best_weight)*p_gbdt+best_weight*p_lstm\n",
    "\n",
    "# Compact gated model: scores + richness + score-by-richness interactions.\n",
    "R=np.column_stack([np.log1p(months[val_idx]),np.log1p(loan_n[val_idx]),np.log1p(event_n[val_idx])])\n",
    "Rsc=StandardScaler().fit(R[cal_pos]);Rz=Rsc.transform(R)\n",
    "g=cliplogit(p_gbdt);l=cliplogit(p_lstm)\n",
    "# Relative-score interactions permit data-driven reliance on LSTM as richness varies.\n",
    "diff=l-g\n",
    "Z=np.column_stack([g,l,Rz,diff[:,None]*Rz])\n",
    "gate=LogisticRegression(C=0.1,max_iter=2000,random_state=SEED)\n",
    "gate.fit(Z[cal_pos],y_val[cal_pos])\n",
    "p_gated=gate.predict_proba(Z)[:,1]\n",
    "\n",
    "rows=[]\n",
    "for name,p in [('M1 (no LSTM)',p_gbdt),('Fixed score blend',p_fixed),\n",
    "               ('Richness-aware logistic fusion',p_gated)]:\n",
    "    rows.append({'method':name,'calibration_auc':safe_auc(y_val[cal_pos],p[cal_pos]),\n",
    "                 'evaluation_auc':safe_auc(y_val[eval_pos],p[eval_pos]),\n",
    "                 'evaluation_pr_auc':safe_ap(y_val[eval_pos],p[eval_pos]),\n",
    "                 'evaluation_n':len(eval_pos),'evaluation_positives':int(y_val[eval_pos].sum())})\n",
    "gated_results=pd.DataFrame(rows)\n",
    "print('Calibration-selected fixed blend LSTM weight:',best_weight)\n",
    "display(gated_results)\n",
    "gated_results.to_csv(OUTPUT_DIR/'richness_aware_fusion_v6.csv',index=False)"
   ]
  },
