    "Xscore = pd.DataFrame({'LSTM_OOF_SCORE': lstm_score}, index=Xbase.index)\n",
    "\n",
    "feature_sets = {\n",
    "    'M_app': Xapp_only,\n",
    "    'M_app_LSTM': pd.concat([Xapp_only, Xscore], axis=1),\n",
    "    'M0': Xbase,\n",
    "    'M1': pd.concat([Xbase, Xhand], axis=1),\n",
    "    'M2': pd.concat([Xbase, Xscore], axis=1),\n",
    "    'M3': pd.concat([Xbase, Xhand, Xscore], axis=1),\n",
    "}\n",
    "\n",
    "def evaluate_feature_sets(feature_sets):\n",
    "    rows = []; fitted = {}; val_pred = {}\n",
    "    for name, X in feature_sets.items():\n",
    "        assert X.columns.is_unique and len(X) == len(ids)\n",
    "        clf = HistGradientBoostingClassifier(**PARAMS, **FIXED)\n",
    "        clf.fit(X.iloc[train_idx], y[train_idx])\n",
    "        p = clf.predict_proba(X.iloc[val_idx])[:, 1]\n",
    "        fitted[name] = clf; val_pred[name] = p\n",
    "        rows.append(dict(model=name, n_features=X.shape[1], trees=clf.n_iter_,\n",
    "                         val_auc=roc_auc_score(y[val_idx], p),\n",
    "                         val_pr_auc=average_precision_score(y[val_idx], p)))\n",
    "        print(name, rows[-1])\n",
    "    return pd.DataFrame(rows), fitted, val_pred\n",
    "\n",
    "fusion_results, fitted_models, val_predictions = evaluate_feature_sets(feature_sets)\n",
    "ref = fusion_results.set_index('model').loc['M0', 'val_auc']\n",
    "fusion_results['delta_auc_vs_M0'] = fusion_results.val_auc - ref\n",
    "display(fusion_results.sort_values('val_auc', ascending=False))\n",
    "fusion_results.to_csv(OUTPUT_DIR / 'fusion_validation_v6.csv', index=False)"
   ]
