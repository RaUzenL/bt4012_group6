    "def safe_auc(y_true, p):\n",
    "    return roc_auc_score(y_true, p) if len(np.unique(y_true)) == 2 else np.nan\n",
    "\n",
    "def safe_ap(y_true, p):\n",
    "    return average_precision_score(y_true, p) if len(np.unique(y_true)) == 2 else np.nan\n",
    "\n",
    "model_names = list(feature_sets.keys())\n",
    "subgroup_rows = []\n",
    "val_meta = richness.iloc[val_idx].reset_index(drop=True)\n",
    "for dimension in ['coverage_group','loan_group','density_group']:\n",
    "    for group in val_meta[dimension].cat.categories:\n",
    "        mask = val_meta[dimension].astype(str).to_numpy() == str(group)\n",
    "        yt = y[val_idx][mask]\n",
    "        if len(yt) == 0: continue\n",
    "        row = {'dimension': dimension, 'group': str(group), 'n': len(yt),\n",
    "               'positives': int(yt.sum()), 'default_rate': float(yt.mean())}\n",
    "        for name in model_names:\n",
    "            p = np.asarray(val_predictions[name])[mask]\n",
    "            row[name + '_auc'] = safe_auc(yt, p)\n",
    "            row[name + '_pr_auc'] = safe_ap(yt, p)\n",
    "        row['delta_auc_M3_minus_M1'] = row['M3_auc'] - row['M1_auc']\n",
    "        row['delta_pr_M3_minus_M1'] = row['M3_pr_auc'] - row['M1_pr_auc']\n",
    "        row['delta_auc_M2_minus_M0'] = row['M2_auc'] - row['M0_auc']\n",
    "        subgroup_rows.append(row)\n",
    "subgroup_results = pd.DataFrame(subgroup_rows)\n",
    "display(subgroup_results[['dimension','group','n','positives','default_rate',\n",
    "                          'M1_auc','M3_auc',\n",
    "                          'delta_auc_M3_minus_M1','delta_pr_M3_minus_M1']])\n",
    "subgroup_results.to_csv(OUTPUT_DIR / 'richness_subgroups_v6.csv', index=False)"
   ]
  },
