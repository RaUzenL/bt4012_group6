    "## 2 · Rebuild Experiment 1 All Sources feature matrix (same feature engineering)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d93c3e9e",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "d93c3e9e",
    "outputId": "9f2599ba-92ab-46f1-e385-dae3ea060b6d"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "History features: 13 columns for 99,277 applicants with any history\n"
     ]
    }
   ],
   "source": [
    "# Bureau: loans at other lenders\n",
    "b = pd.read_parquet(CLEAN / \"bureau.parquet\")\n",
    "bureau = b.groupby(\"SK_ID_CURR\").agg(\n",
    "    n_bureau=(\"SK_ID_BUREAU\", \"size\"),\n",
    "    bureau_debt=(\"AMT_CREDIT_SUM_DEBT\", \"sum\"),\n",
    "    bureau_overdue=(\"AMT_CREDIT_SUM_OVERDUE\", \"sum\"),\n",
    "    bureau_credit=(\"AMT_CREDIT_SUM\", \"sum\"),\n",
    ")\n",
    "bureau[\"bureau_debt_ratio\"] = bureau[\"bureau_debt\"] / bureau[\"bureau_credit\"].where(bureau[\"bureau_credit\"] > 0)\n",
    "\n",
    "# Previous Home Credit applications (duplicate submissions removed)\n",
    "p = pd.read_parquet(CLEAN / \"previous_application.parquet\")\n",
    "p = p[p[\"IS_DUPLICATE_SUBMISSION\"] == 0].copy()\n",
    "p[\"refused\"] = (p[\"NAME_CONTRACT_STATUS\"].astype(str) == \"Refused\").astype(int)\n",
    "prev = p.groupby(\"SK_ID_CURR\").agg(\n",
    "    n_prev=(\"SK_ID_PREV\", \"size\"),\n",
    "    prev_refusal_rate=(\"refused\", \"mean\"),\n",
    "    prev_amt_mean=(\"AMT_APPLICATION\", \"mean\"),\n",
    ")\n",
    "\n",
    "# Instalments: one row per instalment (split payments already merged in cleaning)\n",
    "i = pd.read_parquet(CLEAN / \"installments.parquet\")\n",
    "paid = i[\"DAYS_ENTRY_PAYMENT\"].notna()\n",
    "i[\"late\"] = np.where(paid, (i[\"DAYS_ENTRY_PAYMENT\"] - i[\"DAYS_INSTALMENT\"]) > 0, np.nan)   # unpaid: not counted\n",
    "i[\"under\"] = (i[\"AMT_INSTALMENT\"] - i[\"AMT_PAYMENT\"].fillna(0)).clip(lower=0)\n",
    "inst = i.groupby(\"SK_ID_CURR\").agg(\n",
    "    n_inst=(\"SK_ID_PREV\", \"size\"),\n",
    "    late_rate=(\"late\", \"mean\"),\n",
    "    underpay_mean=(\"under\", \"mean\"),\n",
    ")\n",
    "\n",
    "# Credit cards: utilisation\n",
    "c = pd.read_parquet(CLEAN / \"credit_card.parquet\")\n",
    "c[\"util\"] = c[\"AMT_BALANCE\"] / c[\"AMT_CREDIT_LIMIT_ACTUAL\"].where(c[\"AMT_CREDIT_LIMIT_ACTUAL\"] > 0)\n",
    "cc = c.groupby(\"SK_ID_CURR\").agg(cc_util_mean=(\"util\", \"mean\"), cc_months=(\"MONTHS_BALANCE\", \"nunique\"))\n",
    "\n",
    "hist = bureau.join([prev, inst, cc], how=\"outer\").reset_index()\n",
    "hist_cols = [col for col in hist.columns if col != \"SK_ID_CURR\"]\n",
    "print(f\"History features: {len(hist_cols)} columns for {len(hist):,} applicants with any history\")"
   ]
  },
