    "# All three richness variables use exactly the same observation window as the LSTM.\n",
    "months = observed.sum(axis=1).astype('int32')\n",
    "loan_n = (i_seq.groupby('SK_ID_CURR').SK_ID_PREV.nunique()\n",
    "          .reindex(ids, fill_value=0).to_numpy(dtype='int32'))\n",
    "event_n = (i_seq.groupby('SK_ID_CURR').size()\n",
    "           .reindex(ids, fill_value=0).to_numpy(dtype='int32'))\n",
    "richness = pd.DataFrame({'SK_ID_CURR':ids,'split':app['split'].to_numpy(),\n",
    "                         'TARGET':y,'observed_months':months,\n",
    "                         'distinct_loans':loan_n,'installment_rows':event_n})\n",
    "# Group thresholds are defined without inspecting labels or validation outcomes.\n",
    "richness['coverage_group'] = pd.cut(months, bins=[-1,0,3,8,T],\n",
    "                                  labels=['0 months','1-3 months','4-8 months','9-12 months'])\n",
    "richness['loan_group'] = pd.cut(loan_n, bins=[-1,0,1,3,np.inf],\n",
    "                              labels=['0 loans','1 loan','2-3 loans','4+ loans'])\n",
    "richness['density_group'] = pd.cut(event_n, bins=[-1,0,5,20,np.inf],\n",
    "                                 labels=['0 rows','1-5 rows','6-20 rows','21+ rows'])\n",
    "print('Validation-group sizes and default rates:')\n",
    "for col in ['coverage_group','loan_group','density_group']:\n",
    "    print('\\n',col)\n",
    "    display(richness.iloc[val_idx].groupby(col,observed=True).TARGET.agg(['size','sum','mean']))\n",
    "richness.to_parquet(OUTPUT_DIR/'richness_customer_metadata_v6.parquet',index=False)"
   ]
