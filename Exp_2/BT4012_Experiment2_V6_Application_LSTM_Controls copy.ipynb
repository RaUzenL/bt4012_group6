    "position = pd.Series(np.arange(len(ids)), index=ids)\n",
    "\n",
    "# ── 3a. Installment channels (same as V4) ──────────────────────────────────\n",
    "i_seq = pd.read_parquet(CLEAN / 'installments.parquet')\n",
    "need = ['SK_ID_CURR','SK_ID_PREV','DAYS_INSTALMENT','DAYS_ENTRY_PAYMENT','AMT_INSTALMENT','AMT_PAYMENT']\n",
    "assert set(need).issubset(i_seq.columns)\n",
    "i_seq = i_seq[i_seq.SK_ID_CURR.isin(ids) & i_seq.DAYS_INSTALMENT.notna() & (i_seq.DAYS_INSTALMENT <= 0)].copy()\n",
    "paid_mask = i_seq.DAYS_ENTRY_PAYMENT.notna() & (i_seq.DAYS_ENTRY_PAYMENT <= 0)\n",
    "i_seq['DPD'] = np.where(paid_mask, np.maximum(i_seq.DAYS_ENTRY_PAYMENT - i_seq.DAYS_INSTALMENT, 0), np.nan)\n",
    "i_seq['LATE'] = np.where(paid_mask, (i_seq.DAYS_ENTRY_PAYMENT > i_seq.DAYS_INSTALMENT).astype(float), np.nan)\n",
    "i_seq['PAY_RATIO'] = np.where(paid_mask, i_seq.AMT_PAYMENT / i_seq.AMT_INSTALMENT.where(i_seq.AMT_INSTALMENT > 0), np.nan)\n",
    "i_seq['UNDER_RATIO'] = np.where(paid_mask, ((i_seq.AMT_INSTALMENT - i_seq.AMT_PAYMENT).clip(lower=0) / i_seq.AMT_INSTALMENT.where(i_seq.AMT_INSTALMENT > 0)), np.nan)\n",
    "i_seq['AMOUNT_LOG'] = np.log1p(i_seq.AMT_INSTALMENT.clip(lower=0))\n",
    "i_seq['MONTH_IDX'] = np.floor(-i_seq.DAYS_INSTALMENT / 30).astype('int32')\n",
    "i_seq = i_seq[i_seq.MONTH_IDX.between(0, T - 1)].copy()\n",
    "\n",
    "monthly_inst = i_seq.groupby(['SK_ID_CURR','MONTH_IDX'], sort=False).agg(\n",
    "    DPD_MEAN=('DPD','mean'), DPD_MAX=('DPD','max'), LATE_RATE=('LATE','mean'),\n",
    "    PAYMENT_RATIO=('PAY_RATIO','mean'), UNDERPAYMENT_RATIO=('UNDER_RATIO','mean'),\n",
    "    AMOUNT_LOG=('AMOUNT_LOG','mean'), N_INSTALLMENTS=('SK_ID_PREV','size'),\n",
    "    N_LOANS=('SK_ID_PREV','nunique'), N_PAID=('LATE','count')).reset_index()\n",
    "\n",
    "loan_month = (i_seq.groupby(['SK_ID_CURR','MONTH_IDX','SK_ID_PREV'], sort=False)\n",
    "              .agg(LOAN_DPD=('DPD','max'), LOAN_LATE=('LATE','max')).reset_index())\n",
    "loan_month['LOAN_LATE_FLAG'] = (loan_month['LOAN_LATE'] > 0).astype('float32')\n",
    "loan_month['LOAN_DPD_VALID'] = loan_month['LOAN_DPD'].notna().astype('float32')\n",
    "loan_extra = (loan_month.groupby(['SK_ID_CURR','MONTH_IDX'], sort=False)\n",
    "    .agg(LOAN_DPD_STD=('LOAN_DPD','std'), LOAN_DPD_MAX=('LOAN_DPD','max'),\n",
    "         N_LATE_LOANS=('LOAN_LATE_FLAG','sum'), N_VALID_LOANS=('LOAN_DPD_VALID','sum')).reset_index())\n",
    "loan_extra['LATE_LOAN_SHARE'] = loan_extra.N_LATE_LOANS / loan_extra.N_VALID_LOANS.replace(0, np.nan)\n",
    "monthly_inst = monthly_inst.merge(loan_extra, on=['SK_ID_CURR','MONTH_IDX'], how='left', validate='one_to_one')\n",
    "\n",
    "INST_COLS = ['DPD_MEAN','DPD_MAX','LATE_RATE','PAYMENT_RATIO','UNDERPAYMENT_RATIO',\n",
    "             'AMOUNT_LOG','N_INSTALLMENTS','N_LOANS','N_PAID',\n",
    "             'LOAN_DPD_STD','LOAN_DPD_MAX','N_LATE_LOANS','LATE_LOAN_SHARE']\n",
    "print(f'Installment channels: {len(INST_COLS)}, customers with data: {monthly_inst.SK_ID_CURR.nunique():,}')\n",
    "\n",
    "# ── 3b. Bureau balance channels (NEW — external lender monthly DPD) ────────\n",
    "bb = pd.read_parquet(CLEAN / 'bureau_balance.parquet')\n",
    "bb = bb[bb.SK_ID_CURR.isin(ids)].copy()\n",
    "bb['MONTH_IDX'] = (-bb['MONTHS_BALANCE']).astype('int32')\n",
    "bb = bb[bb.MONTH_IDX.between(0, T - 1)].copy()\n",
    "bb['DPD_VALID'] = bb['STATUS_DPD'].notna().astype('float32')\n",
    "bb['DPD_POS'] = (bb['STATUS_DPD'].fillna(0) > 0).astype('float32')\n",
    "\n",
    "monthly_bb = bb.groupby(['SK_ID_CURR','MONTH_IDX'], sort=False).agg(\n",
    "    BB_DPD_MEAN=('STATUS_DPD','mean'),\n",
    "    BB_DPD_MAX=('STATUS_DPD','max'),\n",
    "    BB_N_ACTIVE=('IS_CLOSED', lambda s: (s == 0).sum()),\n",
    "    BB_LATE_SHARE=('DPD_POS', 'mean'),\n",
    "    BB_N_LOANS=('SK_ID_BUREAU','nunique'),\n",
    ").reset_index()\n",
    "\n",
    "BB_COLS = ['BB_DPD_MEAN','BB_DPD_MAX','BB_N_ACTIVE','BB_LATE_SHARE','BB_N_LOANS']\n",
    "print(f'Bureau balance channels: {len(BB_COLS)}, customers with data: {monthly_bb.SK_ID_CURR.nunique():,}')\n",
    "\n",
    "# ── 3c. POS cash channels (NEW for sequences) ──────────────────────────────\n",
    "pc = pd.read_parquet(CLEAN / 'pos_cash.parquet',\n",
    "                     columns=['SK_ID_CURR','MONTHS_BALANCE','SK_DPD','CNT_INSTALMENT_FUTURE'])\n",
    "pc = pc[pc.SK_ID_CURR.isin(ids)].copy()\n",
    "pc['MONTH_IDX'] = (-pc['MONTHS_BALANCE']).astype('int32')\n",
    "pc = pc[pc.MONTH_IDX.between(0, T - 1)].copy()\n",
    "\n",
    "monthly_pos = pc.groupby(['SK_ID_CURR','MONTH_IDX'], sort=False).agg(\n",
    "    POS_DPD_MEAN=('SK_DPD','mean'),\n",
    "    POS_DPD_MAX=('SK_DPD','max'),\n",
    "    POS_REMAINING=('CNT_INSTALMENT_FUTURE','mean'),\n",
    ").reset_index()\n",
    "\n",
    "POS_COLS = ['POS_DPD_MEAN','POS_DPD_MAX','POS_REMAINING']\n",
    "print(f'POS cash channels: {len(POS_COLS)}, customers with data: {monthly_pos.SK_ID_CURR.nunique():,}')\n",
    "\n",
    "# ── 3d. Credit card channels (NEW for sequences) ───────────────────────────\n",
    "cc_raw = pd.read_parquet(CLEAN / 'credit_card.parquet',\n",
    "    columns=['SK_ID_CURR','MONTHS_BALANCE','AMT_BALANCE','AMT_CREDIT_LIMIT_ACTUAL',\n",
    "             'AMT_INST_MIN_REGULARITY','AMT_PAYMENT_TOTAL_CURRENT','SK_DPD'])\n",
    "cc_raw = cc_raw[cc_raw.SK_ID_CURR.isin(ids)].copy()\n",
    "cc_raw['MONTH_IDX'] = (-cc_raw['MONTHS_BALANCE']).astype('int32')\n",
    "cc_raw = cc_raw[cc_raw.MONTH_IDX.between(0, T - 1)].copy()\n",
    "cc_raw['UTIL'] = cc_raw['AMT_BALANCE'] / cc_raw['AMT_CREDIT_LIMIT_ACTUAL'].where(\n",
    "    cc_raw['AMT_CREDIT_LIMIT_ACTUAL'] > 0)\n",
    "cc_raw['PAY_MIN_RATIO'] = cc_raw['AMT_PAYMENT_TOTAL_CURRENT'] / cc_raw['AMT_INST_MIN_REGULARITY'].where(\n",
    "    cc_raw['AMT_INST_MIN_REGULARITY'] > 0)\n",
    "\n",
    "monthly_cc = cc_raw.groupby(['SK_ID_CURR','MONTH_IDX'], sort=False).agg(\n",
    "    CC_UTIL=('UTIL','mean'),\n",
    "    CC_DPD_MAX=('SK_DPD','max'),\n",
    "    CC_PAY_MIN_RATIO=('PAY_MIN_RATIO','mean'),\n",
    ").reset_index()\n",
    "\n",
    "CC_COLS = ['CC_UTIL','CC_DPD_MAX','CC_PAY_MIN_RATIO']\n",
    "print(f'Credit card channels: {len(CC_COLS)}, customers with data: {monthly_cc.SK_ID_CURR.nunique():,}')\n",
    "\n",
    "# ── 3e. Merge all sources into unified monthly tensor ───────────────────────\n",
    "SEQ_COLS = INST_COLS + BB_COLS + POS_COLS + CC_COLS\n",
    "N_CH = len(SEQ_COLS)\n",
    "seq = np.full((len(ids), T, N_CH), np.nan, dtype=np.float32)\n",
    "observed = np.zeros((len(ids), T), dtype=bool)\n",
    "\n",
    "def fill_tensor(monthly_df, col_names, col_offset):\n",
    "    \"\"\"Fill the appropriate channels in seq tensor from a monthly DataFrame.\"\"\"\n",
    "    valid = monthly_df[monthly_df.SK_ID_CURR.isin(ids)]\n",
    "    r = position.loc[valid.SK_ID_CURR].to_numpy()\n",
    "    t = T - 1 - valid.MONTH_IDX.to_numpy()\n",
    "    vals = valid[col_names].to_numpy(dtype='float32')\n",
    "    seq[r, t, col_offset:col_offset + len(col_names)] = vals\n",
    "    observed[r, t] = True\n",
    "\n",
    "off = 0\n",
    "fill_tensor(monthly_inst, INST_COLS, off); off += len(INST_COLS)\n",
    "fill_tensor(monthly_bb,   BB_COLS,   off); off += len(BB_COLS)\n",
    "fill_tensor(monthly_pos,  POS_COLS,  off); off += len(POS_COLS)\n",
    "fill_tensor(monthly_cc,   CC_COLS,   off); off += len(CC_COLS)\n",
    "\n",
    "# ── 3f. Multi-source handcrafted temporal features (V6: expanded) ──────────\n",
    "def make_temporal_features(seq_arr, obs_arr):\n",
    "    n_feat = 14\n",
    "    z = np.full((len(seq_arr), n_feat), np.nan, dtype='float32')\n",
    "    dpd_idx = SEQ_COLS.index('DPD_MEAN')\n",
    "    ratio_idx = SEQ_COLS.index('PAYMENT_RATIO')\n",
    "    bb_dpd_idx = SEQ_COLS.index('BB_DPD_MEAN')\n",
    "    pos_dpd_idx = SEQ_COLS.index('POS_DPD_MEAN')\n",
    "    cc_util_idx = SEQ_COLS.index('CC_UTIL')\n",
    "    ts = np.arange(T)\n",
    "    for j in range(len(seq_arr)):\n",
    "        dpd = seq_arr[j, :, dpd_idx]; ratio = seq_arr[j, :, ratio_idx]\n",
    "        mask = obs_arr[j] & np.isfinite(dpd)\n",
    "        if mask.sum():\n",
    "            z[j,0] = np.mean(dpd[mask]); z[j,1] = np.std(dpd[mask])\n",
    "            z[j,2] = np.polyfit(ts[mask], dpd[mask], 1)[0] if mask.sum() > 1 else np.nan\n",
    "            recent = dpd[-3:]; earlier = dpd[:-3]\n",
    "            if np.isfinite(recent).any() and np.isfinite(earlier).any():\n",
    "                z[j,3] = np.nanmean(recent) - np.nanmean(earlier)\n",
    "            late = (dpd > 0) & mask; streak = mx = 0\n",
    "            for v in late: streak = streak + 1 if v else 0; mx = max(mx, streak)\n",
    "            z[j,4] = mx\n",
    "        good = obs_arr[j] & np.isfinite(ratio)\n",
    "        if good.sum(): z[j,5] = np.std(ratio[good]); z[j,6] = np.mean(ratio[good])\n",
    "        z[j,7] = obs_arr[j].sum()\n",
    "        # V6: bureau balance DPD features\n",
    "        bb_dpd = seq_arr[j, :, bb_dpd_idx]\n",
    "        bb_mask = obs_arr[j] & np.isfinite(bb_dpd)\n",
    "        if bb_mask.sum():\n",
    "            z[j,8] = np.mean(bb_dpd[bb_mask])\n",
    "            z[j,9] = np.polyfit(ts[bb_mask], bb_dpd[bb_mask], 1)[0] if bb_mask.sum() > 1 else np.nan\n",
    "        # V6: POS DPD mean\n",
    "        pos_dpd = seq_arr[j, :, pos_dpd_idx]\n",
    "        pos_mask = obs_arr[j] & np.isfinite(pos_dpd)\n",
    "        if pos_mask.sum():\n",
    "            z[j,10] = np.mean(pos_dpd[pos_mask])\n",
    "        # V6: credit card utilization features\n",
    "        cc_util = seq_arr[j, :, cc_util_idx]\n",
    "        cc_mask = obs_arr[j] & np.isfinite(cc_util)\n",
    "        if cc_mask.sum():\n",
    "            z[j,11] = np.mean(cc_util[cc_mask])\n",
    "            z[j,12] = np.polyfit(ts[cc_mask], cc_util[cc_mask], 1)[0] if cc_mask.sum() > 1 else np.nan\n",
    "        # V6: cross-source recent deterioration (all DPD channels)\n",
    "        all_dpd = np.column_stack([\n",
    "            seq_arr[j, :, dpd_idx], seq_arr[j, :, bb_dpd_idx], seq_arr[j, :, pos_dpd_idx]])\n",
    "        row_valid = obs_arr[j] & np.any(np.isfinite(all_dpd), axis=1)\n",
    "        if row_valid.sum() > 1:\n",
    "            combined = np.nanmean(all_dpd, axis=1)\n",
    "            r3 = combined[-3:]; e = combined[:-3]\n",
    "            if np.isfinite(r3).any() and np.isfinite(e).any():\n",
    "                z[j,13] = np.nanmean(r3) - np.nanmean(e)\n",
    "    return pd.DataFrame(z, columns=[\n",
    "        'TEMP_DPD_MEAN','TEMP_DPD_VOL','TEMP_DPD_TREND',\n",
    "        'TEMP_RECENT_DETERIORATION','TEMP_MAX_LATE_STREAK','TEMP_PAYMENT_VOL',\n",
    "        'TEMP_PAYMENT_MEAN','TEMP_OBS_MONTHS',\n",
    "        'TEMP_BB_DPD_MEAN','TEMP_BB_DPD_TREND',\n",
    "        'TEMP_POS_DPD_MEAN',\n",
    "        'TEMP_CC_UTIL_MEAN','TEMP_CC_UTIL_TREND',\n",
    "        'TEMP_CROSS_DETERIORATION'])\n",
    "\n",
    "temporal = make_temporal_features(seq, observed)\n",
    "\n",
    "no_hist = int((~observed.any(axis=1)).sum())\n",
    "print(f'\\nMulti-source monthly tensor: {seq.shape} ({N_CH} channels)')\n",
    "print(f'Handcrafted temporal features: {temporal.shape[1]} (V5 had 8)')\n",
    "print(f'Customers without ANY history: {no_hist} ({no_hist/len(ids)*100:.1f}%)')\n",
    "print(f'(V4 had 29,419 with no history using installments only)')"
   ]
