    "## 7 · OOF LSTM **risk-score** feature\n",
    "\n",
    "Each training applicant receives a prediction from a fold model that **never trained on that applicant**. Validation/test predictions are averages from those same fold models. The resulting single scalar has consistent meaning across folds (unlike independently trained hidden-vector coordinates). Internal early stopping uses training-only labels. For stronger cross-fitting, increase `OOF_FOLDS` at a compute cost."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "3a52ab11",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "3a52ab11",
    "outputId": "67520e39-43b1-4918-e5c1-00ddb8fd60bb"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "fold 1/3: fit=41066, stop=5600, oof=23333\n",
      "fold 2/3: fit=41066, stop=5600, oof=23333\n",
      "fold 3/3: fit=41066, stop=5600, oof=23333\n",
      "OOF train AUC (diagnostic only): 0.6032581056536692\n",
      "Ensemble validation AUC: 0.5989422261538648\n"
     ]
    }
   ],
   "source": [
    "def oof_lstm_scores(x, seed=SEED, attention=True, n_folds=OOF_FOLDS):\n",
    "    scores = np.full(len(ids), np.nan, dtype='float32')\n",
    "    val_scores = []; test_scores = []\n",
    "    cv = StratifiedKFold(n_splits=n_folds, shuffle=True, random_state=seed)\n",
    "    for k, (a, b) in enumerate(cv.split(train_idx, y[train_idx]), 1):\n",
    "        pool, hold = train_idx[a], train_idx[b]\n",
    "        fit, stop = train_test_split(pool, test_size=.12, stratify=y[pool], random_state=seed+100+k)\n",
    "        print(f'fold {k}/{n_folds}: fit={len(fit)}, stop={len(stop)}, oof={len(hold)}')\n",
    "        model = train_temporal(fit, stop, x=x, seed=seed+k, attention=attention)\n",
    "        scores[hold] = predict_temporal(model, hold, x)\n",
    "        val_scores.append(predict_temporal(model, val_idx, x))\n",
    "        test_scores.append(predict_temporal(model, test_idx, x))\n",
    "        del model\n",
    "        if torch.cuda.is_available(): torch.cuda.empty_cache()\n",
    "    scores[val_idx] = np.mean(val_scores, axis=0)\n",
    "    scores[test_idx] = np.mean(test_scores, axis=0)\n",
    "    assert np.isfinite(scores).all()\n",
    "    return scores\n",
    "\n",
    "# V6: use attention=False (last_hidden) — outperformed attention 0.600 vs 0.564 in V5\n",
    "lstm_score = oof_lstm_scores(Xseq, attention=False)\n",
    "pd.DataFrame({'SK_ID_CURR': ids, 'split': app['split'], 'LSTM_OOF_SCORE': lstm_score}).to_parquet(\n",
    "    OUTPUT_DIR / 'lstm_oof_risk_scores_v6.parquet', index=False)\n",
    "print('OOF train AUC (diagnostic only):', roc_auc_score(y[train_idx], lstm_score[train_idx]))\n",
    "print('Ensemble validation AUC:', roc_auc_score(y[val_idx], lstm_score[val_idx]))"
   ]
  },
