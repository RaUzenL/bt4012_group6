   "source": [
    "# POS / cash loans\n",
    "q = pd.read_parquet(CLEAN / \"pos_cash.parquet\", columns=[\"SK_ID_CURR\", \"SK_DPD\", \"CNT_INSTALMENT_FUTURE\"])\n",
    "q[\"dpd_flag\"] = (q[\"SK_DPD\"] > 0).astype(\"int32\")\n",
    "pos = q.groupby(\"SK_ID_CURR\").agg(\n",
    "    pos_max_dpd=(\"SK_DPD\", \"max\"),\n",
    "    pos_months_dpd=(\"dpd_flag\", \"sum\"),\n",
    "    pos_remaining_inst=(\"CNT_INSTALMENT_FUTURE\", \"mean\"),\n",
    ")\n",
    "\n",
    "# Credit card, month by month (one row per applicant-month, summed over contracts)\n",
    "c = pd.read_parquet(CLEAN / \"credit_card.parquet\", columns=[\n",
    "    \"SK_ID_CURR\", \"MONTHS_BALANCE\", \"AMT_BALANCE\", \"AMT_CREDIT_LIMIT_ACTUAL\",\n",
    "    \"AMT_INST_MIN_REGULARITY\", \"AMT_PAYMENT_TOTAL_CURRENT\", \"SK_DPD\"])\n",
    "c[\"below_min\"] = ((c[\"AMT_INST_MIN_REGULARITY\"] > 0) &\n",
    "                  (c[\"AMT_PAYMENT_TOTAL_CURRENT\"].fillna(0) < c[\"AMT_INST_MIN_REGULARITY\"])).astype(\"int32\")\n",
    "c[\"dpd_flag\"] = (c[\"SK_DPD\"] > 0).astype(\"int32\")\n",
    "c[\"min_ratio\"] = c[\"AMT_PAYMENT_TOTAL_CURRENT\"] / c[\"AMT_INST_MIN_REGULARITY\"].where(c[\"AMT_INST_MIN_REGULARITY\"] > 0)\n",
    "m = c.groupby([\"SK_ID_CURR\", \"MONTHS_BALANCE\"], as_index=False).agg(\n",
    "    bal=(\"AMT_BALANCE\", \"sum\"), lim=(\"AMT_CREDIT_LIMIT_ACTUAL\", \"sum\"),\n",
    "    below=(\"below_min\", \"max\"), dpd=(\"dpd_flag\", \"max\"), min_ratio=(\"min_ratio\", \"mean\"))\n",
    "m[\"util\"] = m[\"bal\"] / m[\"lim\"].where(m[\"lim\"] > 0)\n",
    "recent = m[m[\"MONTHS_BALANCE\"] >= -3].groupby(\"SK_ID_CURR\")[\"util\"].mean()\n",
    "card = m.groupby(\"SK_ID_CURR\").agg(\n",
    "    cc_months_below_min=(\"below\", \"sum\"),\n",
    "    cc_months_dpd=(\"dpd\", \"sum\"),\n",
    "    cc_min_ratio_mean=(\"min_ratio\", \"mean\"),\n",
    "    cc_util_overall=(\"util\", \"mean\"),\n",
    ")\n",
    "card[\"cc_balance_trend\"] = recent.reindex(card.index) - card[\"cc_util_overall\"]\n",
    "card = card.drop(columns=\"cc_util_overall\")\n",
    "\n",
    "# Instalments\n",
    "i = pd.read_parquet(CLEAN / \"installments.parquet\", columns=[\n",
    "    \"SK_ID_CURR\", \"DAYS_INSTALMENT\", \"DAYS_ENTRY_PAYMENT\", \"AMT_INSTALMENT\", \"AMT_PAYMENT\"])\n",
    "paid = i[\"DAYS_ENTRY_PAYMENT\"].notna()\n",
    "i[\"days_late\"] = np.where(paid, (i[\"DAYS_ENTRY_PAYMENT\"] - i[\"DAYS_INSTALMENT\"]).clip(lower=0), np.nan)\n",
    "i[\"under_flag\"] = ((i[\"AMT_INSTALMENT\"] - i[\"AMT_PAYMENT\"].fillna(0)) > 1.0).astype(\"int32\")\n",
    "i[\"paid_amt\"] = i[\"AMT_PAYMENT\"].fillna(0)\n",
    "inst_new = i.groupby(\"SK_ID_CURR\").agg(\n",
    "    inst_max_days_late=(\"days_late\", \"max\"),\n",
    "    inst_mean_days_late=(\"days_late\", \"mean\"),\n",
    "    inst_underpay_freq=(\"under_flag\", \"mean\"),\n",
    "    paid_sum=(\"paid_amt\", \"sum\"),\n",
    "    due_sum=(\"AMT_INSTALMENT\", \"sum\"),\n",
    ")\n",
    "inst_new[\"inst_paid_to_due\"] = inst_new[\"paid_sum\"] / inst_new[\"due_sum\"].where(inst_new[\"due_sum\"] > 0)\n",
    "inst_new = inst_new.drop(columns=[\"paid_sum\", \"due_sum\"])\n",
    "\n",
    "# Bureau (loan-level)\n",
    "b = pd.read_parquet(CLEAN / \"bureau.parquet\", columns=[\"SK_ID_CURR\", \"CREDIT_DAY_OVERDUE\", \"CREDIT_ACTIVE\"])\n",
    "bureau_new = b.groupby(\"SK_ID_CURR\").agg(\n",
    "    bureau_max_days_overdue=(\"CREDIT_DAY_OVERDUE\", \"max\"),\n",
    "    bureau_active_count=(\"CREDIT_ACTIVE\", lambda s: (s.astype(str) == \"Active\").sum()),\n",
    ")\n",
    "\n",
    "# V6: Bureau balance flat aggregates (monthly DPD from external lenders)\n",
    "bb_flat = pd.read_parquet(CLEAN / \"bureau_balance.parquet\", columns=[\"SK_ID_CURR\", \"STATUS_DPD\"])\n",
    "bb_flat[\"dpd_flag\"] = (bb_flat[\"STATUS_DPD\"].fillna(0) > 0).astype(\"int32\")\n",
    "bb_agg = bb_flat.groupby(\"SK_ID_CURR\").agg(\n",
    "    bb_max_dpd=(\"STATUS_DPD\", \"max\"),\n",
    "    bb_months_with_dpd=(\"dpd_flag\", \"sum\"),\n",
    "    bb_ever_late_share=(\"dpd_flag\", \"mean\"),\n",
    ")\n",
    "print(f\"Bureau balance flat: {len(bb_agg):,} applicants\")\n",
    "\n",
    "# Previous applications\n",
    "p = pd.read_parquet(CLEAN / \"previous_application.parquet\", columns=[\n",
    "    \"SK_ID_CURR\", \"NAME_CONTRACT_STATUS\", \"DAYS_DECISION\", \"IS_DUPLICATE_SUBMISSION\"])\n",
    "p = p[p[\"IS_DUPLICATE_SUBMISSION\"] == 0].copy()\n",
    "p[\"approved\"] = (p[\"NAME_CONTRACT_STATUS\"].astype(str) == \"Approved\").astype(\"int32\")\n",
    "p[\"last_year\"] = (p[\"DAYS_DECISION\"] >= -365).astype(\"int32\")\n",
    "prev_new = p.groupby(\"SK_ID_CURR\").agg(prev_approval_rate=(\"approved\", \"mean\"), prev_apps_last_year=(\"last_year\", \"sum\"))\n",
    "\n",
    "new_hist = pos.join([card, inst_new, bureau_new, bb_agg, prev_new], how=\"outer\").reset_index()\n",
    "NEW_POS = [\"pos_max_dpd\", \"pos_months_dpd\", \"pos_remaining_inst\"]\n",
    "NEW_CARD = [\"cc_months_below_min\", \"cc_months_dpd\", \"cc_min_ratio_mean\", \"cc_balance_trend\"]\n",
    "NEW_INST = [\"inst_max_days_late\", \"inst_mean_days_late\", \"inst_underpay_freq\", \"inst_paid_to_due\"]\n",
    "NEW_BUREAU = [\"bureau_max_days_overdue\", \"bureau_active_count\"]\n",
    "NEW_BB = [\"bb_max_dpd\", \"bb_months_with_dpd\", \"bb_ever_late_share\"]\n",
    "NEW_PREV = [\"prev_approval_rate\", \"prev_apps_last_year\"]\n",
    "assert set(NEW_POS + NEW_CARD + NEW_INST + NEW_BUREAU + NEW_BB + NEW_PREV) == set(new_hist.columns) - {\"SK_ID_CURR\"}\n",
    "print(f\"New features: {len(new_hist.columns) - 1} columns for {len(new_hist):,} applicants\")\n",
    "display(new_hist.describe().T[[\"count\", \"mean\", \"min\", \"max\"]].round(3))"
